# ==========================================
# CNOOC Demo - 后端环境配置文件模板
# ==========================================
# 使用方式: cp .env.example .env 然后修改 .env 中的值
# 注意: .env 文件不应提交到 Git

# ---------- 数据库 ----------
# SQLite（默认，开发环境）
DATABASE_URL=sqlite:///../data/cnooc.db

# PostgreSQL（生产环境，需要先安装 psycopg2-binary）
# DATABASE_URL=postgresql://user:password@host:5432/cnooc

# ---------- Flask 密钥 ----------
# 生产环境请务必修改为随机字符串
SECRET_KEY=change-me-to-a-random-secret

# ---------- JWT ----------
JWT_EXPIRATION_HOURS=72
JWT_ALGORITHM=HS256

# ---------- 鉴权提供者 ----------
# local: 使用本地用户表认证
# dify:  对接 Dify 用户体系（预留）
AUTH_PROVIDER=local

# ---------- 管理员初始化配置 ----------
# 初始化/重置管理员账号时使用（scripts/init_admin.py）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@cnooc.com
ADMIN_DISPLAY_NAME=系统管理员

# ---------- Dify 控制台（预留） ----------
# DIFY_CONSOLE_URL=http://localhost
# DIFY_ADMIN_API_KEY=