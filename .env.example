# ─────────────────────────────────────────────────────────────
# 运行期配置模板（可提交，复制为 .env 后按需修改）
# 客户端可访问的配置必须带 NEXT_PUBLIC_ 前缀
# ─────────────────────────────────────────────────────────────

# 开发模式主后端 API 地址（前端直连，不走 nginx 代理）
NEXT_PUBLIC_DEV_API_BASE_URL=http://192.168.10.168:26039

# 开发模式文件服务地址（Flask 后端，用于附件上传/下载直连）
NEXT_PUBLIC_DEV_FILE_API_BASE_URL=http://localhost:5000/api

# Mock / 设置页默认 Dify base url
NEXT_PUBLIC_DEFAULT_DIFY_BASE_URL=https://api.dify.ai/v1

# Dify 客户端默认 userId（用户未传入时使用）
NEXT_PUBLIC_DIFY_DEFAULT_USER_ID=192.168.11.30

# 未登录/游客请求携带的默认 clientId
NEXT_PUBLIC_DEFAULT_CLIENT_ID=0d4c873ff6146ecd7f38e2e45526ab1b
